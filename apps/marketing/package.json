{
  "name": "@jukkai/marketing",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "imports": {
    "#/*": "./src/*"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "bun ../../scripts/fonts-generated-check.ts && astro build",
    "dev": "bun ../../scripts/fonts-generated-check.ts && astro dev --host 0.0.0.0",
    "lint": "eslint . --ext .js,.mjs,.cjs,.ts,.astro && stylelint \"src/**/*.css\" --allow-empty-input",
    "lint:fix": "eslint . --ext .js,.mjs,.cjs,.ts,.astro --fix && stylelint \"src/**/*.css\" --fix --allow-empty-input",
    "preview": "astro preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.1",
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/jsdom": "^30.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
