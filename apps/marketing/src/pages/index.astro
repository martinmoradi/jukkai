---
import { Image } from 'astro:assets';

import sphere from '#/assets/jukkai-sphere.svg';
import material from '#/assets/magazine/capri-material.webp';
import crystelle from '#/assets/magazine/crystelle-galerie.webp';
import Arrow from '#/components/Arrow.astro';
import { CRYSTELLE } from '#/data/crystelle';
import { GALERIE_IMAGES, HERO_ARTWORK } from '#/data/galerie';
import EditorialLayout from '#/layouts/EditorialLayout.astro';
import styles from '#/styles/landing.module.css';

const [painting, objects, dogs] = GALERIE_IMAGES;
---

<EditorialLayout
  title='Jukkai by Crystelle Terrasson — Galerie & architecture d’intérieur, Châteaugiron'
  description='Jukkai by Crystelle Terrasson réunit architecture d’intérieur et Galerie à Châteaugiron, près de Rennes, dans la continuité de Studio Terrasson. Ouverture en octobre 2026.'>
  <section class={styles.hero} data-art-sequence aria-labelledby='hero-title'>
    <div class={styles.heroStage} data-art-stage>
      <div class={styles.heroBackdrop} data-art-backdrop aria-hidden='true'>
        La Galerie
      </div>
      <div class={styles.heroCopy} data-art-intro>
        <p class={styles.heroCategory}>Architecture d’intérieur & Galerie</p>
        <h1 id='hero-title'>
          L’art <span>prend{' '}<br class={styles.desktopBreak} />place.</span>
        </h1>
        <p class={styles.heroIntroduction}>
          À Châteaugiron, Crystelle Terrasson réunit son studio d’architecture
          d’intérieur et une Galerie. Bienvenue chez Jukkai.
        </p>
        <a class={styles.openingLink} href='#ouverture'
          >Ouverture officielle · octobre 2026 <Arrow diagonal /></a
        >
        <a class={styles.exploreLink} href='#galerie'
          >Découvrir la Galerie <span aria-hidden='true'>↓</span></a
        >
      </div>
      <figure class={styles.heroFigure}>
        <a
          class={styles.heroArtLink}
          href={HERO_ARTWORK.image.src}
          data-art-frame
          data-artwork='hero'
          data-art-src={HERO_ARTWORK.image.src}
          data-art-caption={HERO_ARTWORK.caption}
          aria-label='Voir l’œuvre entière de Yoann Bonneville'
          aria-haspopup='dialog'>
          <Image
            src={HERO_ARTWORK.image}
            alt={HERO_ARTWORK.alt}
            widths={[480, 800, 1200, 1600]}
            sizes='(max-width: 800px) 140vw, 85vw'
            width={1600}
            loading='eager'
            fetchpriority='high'
            quality={88}
            data-art-hero-image
          />
        </a>
        <figcaption class={styles.heroCaption} data-art-credit>
          <span
            >Yoann Bonneville <span class={styles.creditMedium}>· Peinture</span
            ></span
          >
          <a
            href={HERO_ARTWORK.image.src}
            data-artwork='hero-caption'
            data-art-src={HERO_ARTWORK.image.src}
            data-art-caption={HERO_ARTWORK.caption}
            data-art-alt={HERO_ARTWORK.alt}
            aria-haspopup='dialog'
            >Voir en entier <span aria-hidden='true'>↗</span></a
          >
        </figcaption>
      </figure>
      <span class={styles.sequenceLine} data-art-progress aria-hidden='true'
      ></span>
    </div>
    <script is:inline>
      // Reserve the enhanced composition before the first paint. If JavaScript
      // is unavailable, the complete artwork remains in the ordinary document.
      if (
        matchMedia(
          '(prefers-reduced-motion: no-preference) and (min-height: 600px)',
        ).matches
      ) {
        const sequence = document.currentScript.closest('[data-art-sequence]');
        sequence.dataset.motion = 'ready';
        const stage = sequence.querySelector('[data-art-stage]');
        const intro = sequence.querySelector('[data-art-intro]');
        const mobile = matchMedia('(max-width: 800px)').matches;
        // These are the same first-pose measurements used by ScrollTrigger.
        const size = Math.min(
          stage.clientWidth * (mobile ? 0.84 : 0.48),
          stage.clientHeight * (mobile ? 0.64 : 0.78),
        );
        const close = mobile
          ? Math.max(stage.clientWidth, stage.clientHeight * 0.47) * 1.5
          : Math.max(stage.clientWidth * 0.54, stage.clientHeight) * 1.28;
        sequence.style.setProperty('--art-close-scale', close / size);
        sequence.style.setProperty(
          '--art-close-x',
          `${mobile ? 0 : stage.clientWidth * 0.23}px`,
        );
        sequence.style.setProperty(
          '--art-close-y',
          `${mobile ? intro.offsetHeight + 77 + close * 0.22 - stage.clientHeight / 2 : 0}px`,
        );
        sequence.style.setProperty(
          '--art-close-crop',
          mobile
            ? `inset(${intro.offsetHeight + 12}px 0 0 0)`
            : 'inset(0 0 0 46%)',
        );
        // Also recover if the page's enhancement module itself never arrives.
        setTimeout(() => {
          if (!sequence.dataset.animated)
            sequence.removeAttribute('data-motion');
        }, 5000);
      }
    </script>
  </section>

  <section class={styles.galerie} id='galerie' aria-labelledby='galerie-title'>
    <div class={styles.galleryHeading}>
      <div>
        <p class='eyebrow'>La sélection de Crystelle</p>
        <h2 id='galerie-title'>De l’art.<br /><em>De la personnalité.</em></h2>
      </div>
      <p class={styles.galleryIntroduction}>
        Des peintures qui accrochent l’œil, des sculptures qui ne se tiennent
        pas tout à fait sages. Une sélection personnelle de Crystelle, à
        découvrir de près.
      </p>
    </div>
    <div class={styles.artworkSpread}>
      {
        [painting, objects].map((art, index) => (
          <figure
            class:list={[styles.artwork, index === 1 && styles.sculptures]}>
            <figcaption>
              <>
                <span>{art.caption}</span>
                <span>{art.detail}</span>
              </>
            </figcaption>
            <a
              class={styles.artworkButton}
              href={art.image.src}
              data-artwork={index}
              data-art-src={art.image.src}
              data-art-caption={art.caption}
              aria-label={`Agrandir : ${art.caption}`}
              aria-haspopup='dialog'>
              <Image
                src={art.image}
                data-art-reveal
                alt={art.alt}
                widths={[480, 800, 1200, 1600]}
                sizes='(max-width: 800px) 90vw, 42vw'
                width={1200}
                loading='lazy'
              />
              <span class={styles.viewArtwork} aria-hidden='true'>
                Voir de plus près <span>↗</span>
              </span>
            </a>
          </figure>
        ))
      }
    </div>
    <div class={styles.galleryFoot}>
      <p>Peintures, sculptures & objets singuliers.</p>
      <a class='text-link' href='/contact/'
        >Une œuvre vous intrigue ? <Arrow diagonal /></a
      >
    </div>
    <div class={styles.company}>
      <div class={styles.companyCopy}>
        <p class='eyebrow'>L’art, en bonne compagnie</p>
        <h3>On peut aussi<br /><em>sourire.</em></h3>
        <p>Deux sculptures.<br />Et un invité surprise.</p>
      </div>
      <figure class={styles.dogs}>
        <figcaption>{dogs.caption}</figcaption>
        <a
          class={styles.artworkButton}
          href={dogs.image.src}
          data-artwork='dogs'
          data-art-src={dogs.image.src}
          data-art-caption={dogs.caption}
          aria-label={`Agrandir : ${dogs.caption}`}
          aria-haspopup='dialog'>
          <Image
            src={dogs.image}
            data-art-reveal
            alt={dogs.alt}
            widths={[480, 800, 1200, 1800]}
            sizes='(max-width: 800px) 100vw, 60vw'
            width={1400}
            loading='lazy'
          />
          <span class={styles.viewArtwork} aria-hidden='true'
            >Voir la scène <span>↗</span></span
          >
        </a>
      </figure>
    </div>
  </section>

  <section class={styles.story} id='esprit' aria-labelledby='story-title'>
    <div class={styles.storyHeading}>
      <p class='eyebrow'>À l’origine de Jukkai</p>
      <h2 id='story-title'>Crystelle<br /><span>ouvre le jeu.</span></h2>
    </div>
    <div class={styles.storyGrid}>
      <figure class={styles.portrait} data-portrait-reveal>
        <Image
          src={crystelle}
          alt='Crystelle Terrasson, assise parmi les peintures et sculptures qu’elle réunit pour Jukkai.'
          widths={[640, 960, 1440, 1920]}
          sizes='(max-width: 800px) 100vw, 56vw'
          width={1440}
          loading='lazy'
        />
        <figcaption>
          Crystelle Terrasson · Architecte d’intérieur, fondatrice de Jukkai
        </figcaption>
      </figure>
      <div class={styles.storyCopy}>
        <p class={styles.storyLead}>
          Une architecte d’intérieur.<br />Une passion pour l’art.<br
          />Désormais, un même lieu.
        </p>
        <p>
          Vous connaissez peut-être Crystelle Terrasson à travers Studio
          Terrasson, son agence d’architecture d’intérieur. Avec Jukkai, elle
          prolonge cette histoire et lui donne une nouvelle dimension : une
          Galerie, aux côtés du studio, à Châteaugiron.
        </p>
        <p>
          Après 30 ans de métier, l’envie reste la même : composer avec les
          couleurs, les matières et les personnalités. Ici, elle partage aussi
          les œuvres qu’elle aime.
        </p>
        <a class='text-link' href='/contact/'
          >Échanger avec Crystelle <Arrow diagonal /></a
        >
      </div>
    </div>
    <div class={styles.architecture} id='architecture'>
      <figure class={styles.material}>
        <Image
          src={material}
          alt='Au restaurant Le Capri, la lumière souligne une table en bois cerclée de métal et des assises bleues et mauves.'
          widths={[480, 800, 1200, 1800]}
          sizes='(max-width: 800px) 90vw, 38vw'
          width={1000}
          loading='lazy'
        />
        <figcaption>Le Capri · Un projet du Studio Terrasson</figcaption>
      </figure>
      <div class={styles.architectureCopy}>
        <h3>L’architecture continue.</h3>
        <p>
          Crystelle et Laura, toutes deux architectes d’intérieur diplômées,
          vous accompagnent déjà dans vos projets. Le studio reçoit sur
          rendez-vous à la nouvelle adresse, sans attendre octobre.
        </p>
        <a class='text-link' href='https://www.studioterrasson.fr/'
          >Retrouver les projets sur Studio Terrasson <Arrow diagonal /></a
        >
      </div>
    </div>
  </section>

  <section
    class={styles.opening}
    id='ouverture'
    aria-labelledby='opening-title'>
    <div class={styles.openingTop}>
      <p class='eyebrow'>Châteaugiron · À deux pas de Rennes</p>
      <p>Architecture d’intérieur & Galerie</p>
    </div>
    <div class={styles.openingHeading}>
      <h2 id='opening-title'>
        <span>Ouverture officielle</span>octobre<br /><em>2026</em>
      </h2>
      <img src={sphere.src} alt='' width='180' height='180' data-opening-mark />
    </div>
    <div class={styles.openingBottom}>
      <address>
        <strong>Jukkai by Crystelle Terrasson</strong><br />{
          CRYSTELLE.address.street
        }<br />{`${CRYSTELLE.address.postalCode} ${CRYSTELLE.address.locality}`}
      </address>
      <p>
        Une question sur la Galerie ou un projet d’intérieur ? Crystelle est
        déjà joignable.
      </p>
      <a class={styles.contactButton} href='/contact/'
        >Prenons contact <Arrow diagonal /></a
      >
    </div>
  </section>

  <dialog
    class={styles.artDialog}
    data-art-dialog
    aria-labelledby='art-dialog-caption'>
    <div class={styles.dialogBar}>
      <span>La Galerie · Jukkai</span>
      <button type='button' data-art-close aria-label='Fermer l’image'
        >Fermer <span aria-hidden='true'>×</span></button
      >
    </div>
    <figure>
      <img data-art-image alt='' /><figcaption
        id='art-dialog-caption'
        data-art-caption>
      </figcaption>
    </figure>
  </dialog>
</EditorialLayout>
