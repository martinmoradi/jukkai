---
import { Image } from 'astro:assets';

import ouverture from '#/assets/magazine/ouverture.webp';
import styles from '#/styles/introduction.module.css';

const caption = 'Peintures et sculptures réunies pour Jukkai';
---

<section
  class={styles.introduction}
  id='esprit'
  aria-labelledby='origin-title'
  data-introduction>
  <div class={styles.name}>
    <span>Jukkai</span>
    <span lang='ja'>述懐</span>
    <span class={styles.interpretation}>Interprétation éditoriale du nom</span>
  </div>
  <h2 id='origin-title' class={styles.phrase} data-intro-phrase>
    <span class={styles.accessible}>Délivrer ce que le cœur gardait.</span>
    <span class={styles.phraseVisual} aria-hidden='true'>
      <span class={styles.phraseLine} data-intro-line>Délivrer ce que</span>
      <span class={styles.phraseLine} data-intro-line>le cœur gardait.</span>
    </span>
  </h2>
  <div class={styles.story}>
    <p class={styles.chapter}>Un nouveau chapitre</p>
    <p class={styles.lead}>
      <span class={styles.leadOpening}>Depuis trente ans,</span>{' '}
      <span class={styles.keepTogether}>Crystelle Terrasson</span>{' '}
      imagine{' '}<span class={styles.keepTogether}>des intérieurs.</span>
    </p>
    <figure class={styles.photograph}>
      <a
        href={ouverture.src}
        data-picture-parallax
        data-artwork='introduction-ouverture'
        data-art-src={ouverture.src}
        data-art-caption={caption}
        aria-label={`Explorer les détails : ${caption}`}
        aria-haspopup='dialog'>
        <Image
          src={ouverture}
          alt='Peintures colorées, grande toile bleue et figurines réunies autour d’un chevalet, près d’une fenêtre.'
          widths={[480, 800, 1200, 1600]}
          sizes='(max-width: 800px) calc(100vw - 40px), 40vw'
          width={1600}
          loading='lazy'
        />
      </a>
    </figure>
    <div class={styles.continuation}>
      <p class={styles.turn}>
        <span>Aujourd’hui,</span>{' '}
        <span>le <span class={styles.keepTogether}>Studio Terrasson</span></span
        >{' '}
        <span>devient Jukkai.</span>
      </p>
      <p class={styles.detail}>
        À Châteaugiron, le studio qu’elle a fondé en 2012 poursuit ses projets
        d’architecture intérieure. Une galerie d’art le rejoint, née d’une envie
        de longue date : travailler au contact des artistes et partager les
        œuvres qui la touchent.
      </p>
    </div>
  </div>
</section>
