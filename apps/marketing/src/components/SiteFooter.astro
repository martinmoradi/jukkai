---
import wordmark from '#/assets/magazine/jukkai-wordmark-primary-no-byline.svg';
import Arrow from '#/components/Arrow.astro';
import { CRYSTELLE } from '#/data/crystelle';
import styles from '#/styles/chrome.module.css';
---

<footer class={styles.footer}>
  <div class={styles.footerInfo}>
    <a class={styles.footerMark} href='/' aria-label='Jukkai — accueil'>
      <img
        src={wordmark.src}
        width='190'
        height='76'
        alt='Jukkai'
        loading='lazy'
      />
    </a>
    <address>
      <span>Jukkai by Crystelle Terrasson</span><br />
      {CRYSTELLE.address.street}<br />
      {`${CRYSTELLE.address.postalCode} ${CRYSTELLE.address.locality}`}
    </address>
    <div class={styles.footerLinks}>
      <a href={`tel:${CRYSTELLE.phoneTel}`}>{CRYSTELLE.phoneDisplay}</a>
      <a href={`mailto:${CRYSTELLE.email}`}>{CRYSTELLE.email}</a>
      <a href={CRYSTELLE.instagram.url}>Instagram <Arrow diagonal /></a>
    </div>
    <nav class={styles.footerLinks} aria-label='Navigation de bas de page'>
      <a href='/#galerie'>La Galerie</a>
      <a href='/#esprit'>Crystelle & Jukkai</a>
      <a href='/#architecture'>Architecture d’intérieur</a>
      <a href='/contact/'>Contact <Arrow diagonal /></a>
    </nav>
  </div>
  <div class={styles.colophon}>
    <span>Architecture d’intérieur & Galerie</span>
    <span>Châteaugiron · Près de Rennes</span>
    <a href='#contenu'>Revenir en haut ↑</a>
  </div>
</footer>
