---
import { Image } from 'astro:assets';

import { CRYSTELLE_DESCRIPTION } from '#/data/crystelle';
import { CRYSTELLE_PORTRAIT } from '#/data/crystelle-portrait';
---

<figure class='card__portrait'>
  <Image
    class='card__portrait-image'
    src={CRYSTELLE_PORTRAIT}
    alt={CRYSTELLE_DESCRIPTION}
    width={640}
    height={640}
    quality={90}
    loading='eager'
    fetchpriority='high'
  />
</figure>
