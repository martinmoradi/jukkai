---
import wordmark from '#/assets/magazine/jukkai-wordmark-primary-no-byline.svg';
import EditorialButton from '#/components/EditorialButton.astro';
import RollingLabel from '#/components/RollingLabel.astro';
import styles from '#/styles/chrome.module.css';

interface Props {
  contact?: boolean;
}
const { contact = false } = Astro.props;
const sections = [
  { href: '/#galerie', label: 'La Galerie' },
  { href: '/#esprit', label: 'Crystelle & Jukkai' },
  { href: '/#ouverture', label: 'Le lieu' },
];
---

<header
  class={styles.header}
  data-site-header
  data-immersive={!contact || undefined}
  data-on-film={!contact || undefined}>
  <a class={styles.brand} href='/' aria-label='Jukkai — accueil'>
    <img src={wordmark.src} width='120' height='48' alt='Jukkai' />
  </a>
  <nav class={styles.navigation} aria-label='Navigation principale'>
    {
      sections.map(({ href, label }) => (
        <a class={styles.sectionLink} href={href} aria-label={label}>
          <RollingLabel text={label} />
        </a>
      ))
    }
    <EditorialButton
      href='/contact/'
      label='Contact'
      aria-current={contact ? 'page' : undefined}
    />
  </nav>
</header>
