---
import { Image } from 'astro:assets';

import crystelle from '#/assets/magazine/crystelle-galerie.webp';
import Arrow from '#/components/Arrow.astro';
import VoyageHeading from '#/components/VoyageHeading.astro';
import { GALERIE_IMAGES, HERO_ARTWORK, SPIRAL_ARTWORKS } from '#/data/galerie';
import styles from '#/styles/artwork-sequence.module.css';

const [, objects, dogs, bears] = GALERIE_IMAGES;
const dogCaption = 'Un seul des trois réclame des caresses.';
const scenes = [
  {
    ...bears,
    key: 'home',
    sizes: '(max-width: 800px) 72vw, 36vw',
    width: 1200,
  },
  {
    ...objects,
    key: 'gift',
    sizes: '(max-width: 800px) 44vw, 22vw',
    width: 900,
  },
] as const;
---

<section
  class={styles.sequence}
  id='galerie'
  aria-labelledby='sequence-title'
  data-art-sequence>
  <div class={styles.galleryIntro} id='selection'>
    <figure class={styles.galleryFigure} data-picture-parallax>
      <a
        class={styles.artwork}
        href={dogs.image.src}
        data-artwork='scene-1'
        data-art-src={dogs.image.src}
        data-art-caption={dogCaption}
        aria-label={`Explorer les détails : ${dogs.caption}`}
        aria-haspopup='dialog'>
        <Image
          src={dogs.image}
          alt={dogs.alt}
          widths={[640, 960, 1440]}
          sizes='(max-width: 800px) 100vw, 54vw'
          width={1440}
          loading='lazy'
        />
      </a>
      <figcaption>
        {dogCaption}
        <Arrow diagonal />
      </figcaption>
    </figure>
    <div class={styles.galleryCopy}>
      <h2 id='sequence-title' class='eyebrow'>
        La Galerie
      </h2>
      <p class={styles.line}>
        Des œuvres
        <br />
        avec lesquelles
        <br />
        vivre.
      </p>
      <p class={styles.offer}>
        Un lieu où flâner, le temps d’un café. Une peinture pour chez soi, une
        édition numérotée à offrir, une petite sculpture qui fait sourire.
        Crystelle choisit les pièces qui la touchent, avec une place pour
        l’humour, la couleur et l’inattendu.
      </p>
    </div>
  </div>
  <div class={styles.motionTrack} data-art-track>
    <div class={styles.stage} data-art-stage>
      <VoyageHeading
        class={styles.invitationHeading}
        data-invitation-heading
        align='center'
        lines={['L’art de s’attacher.']}
      />
      <p class={styles.invitation} data-spiral-invitation>
        <span class={styles.pour} aria-hidden='true'>
          Pour
        </span>
        <span class={styles.roll} data-roll>
          <span class={styles.word} data-roll-word>
            <span class={styles.pourRepeat}>Pour </span>chez soi.
          </span>
          <span class={styles.word} data-roll-word>
            <span class={styles.pourRepeat}>Pour </span>quelqu’un.
          </span>
          <span class={styles.word} data-roll-word>
            <span class={styles.pourRepeat}>Pour </span>le plaisir.
          </span>
        </span>
      </p>
      <div class={styles.scenes}>
        {scenes.map((scene) => (
          <figure
            class={styles.scene}
            data-scene={scene.key}
            data-scene-home={scene.key === 'home' || undefined}
            data-scene-gift={scene.key === 'gift' || undefined}>
            <a
              class={styles.artwork}
              href={scene.image.src}
              data-artwork={`scene-${scene.key}`}
              data-art-src={scene.image.src}
              data-art-caption={scene.caption}
              aria-label={`Explorer les détails : ${scene.caption}`}
              aria-haspopup='dialog'>
              <Image
                src={scene.image}
                alt={scene.alt}
                widths={[480, 800, 1200]}
                sizes={scene.sizes}
                width={scene.width}
                loading='lazy'
              />
            </a>
            <figcaption>
              {scene.caption}
              <span aria-hidden='true'>↗</span>
            </figcaption>
          </figure>
        ))}
      </div>
      <div class={styles.spiral} data-spiral>
        {SPIRAL_ARTWORKS.map((art, index) => (
          <figure class={styles.orbit} data-spiral-orbit>
            <a
              class={styles.artwork}
              href={art.image.src}
              data-spiral-art
              data-artwork={`spiral-${index}`}
              data-art-src={art.image.src}
              data-art-caption={art.caption}
              aria-label={`Explorer les détails : ${art.caption}`}
              aria-haspopup='dialog'>
              <Image
                src={art.image}
                alt={art.alt}
                widths={[480, 800, 1200, 1600]}
                sizes='(max-width: 800px) 76vw, 40vw'
                width={1200}
                loading='lazy'
                quality={88}
                data-art-hero-image={index === 4 || undefined}
              />
            </a>
            <figcaption>{art.caption}</figcaption>
          </figure>
        ))}
      </div>
      <div class={styles.stackCredit} data-stack-credit>
        <a
          href={HERO_ARTWORK.image.src}
          data-artwork='stack-caption'
          data-art-src={HERO_ARTWORK.image.src}
          data-art-caption={HERO_ARTWORK.caption}
          data-art-alt={HERO_ARTWORK.alt}
          aria-haspopup='dialog'>
          Yoann Bonneville <span aria-hidden='true'>↗</span>
        </a>
      </div>
      <section
        class={styles.story}
        id='crystelle'
        aria-labelledby='story-title'
        data-story-scene>
        <figure class={styles.portrait} data-story-photo>
          <Image
            src={crystelle}
            alt='Crystelle Terrasson, assise parmi les peintures et sculptures qu’elle réunit pour Jukkai.'
            widths={[640, 960, 1440, 1920]}
            sizes='(max-width: 800px) 100vw, 56vw'
            width={1440}
            loading='lazy'
            data-portrait-image
          />
        </figure>
        <div class={styles.storyCopy} data-story-copy>
          <h2 id='story-title'>
            Crystelle <br />
            Terrasson
          </h2>
          <p class={styles.profession}>Architecte d’intérieur</p>
          <div class={styles.biography}>
            <p id='architecture'>
              Au studio, Crystelle travaille avec Laura Corbel. Toutes deux
              architectes d’intérieur diplômées, elles partent des envies, des
              usages et des contraintes du lieu pour imaginer chaque projet.
            </p>
            <p>
              La Galerie vient d’un rêve de petite fille : travailler au contact
              des artistes. Crystelle découvre leurs univers, suit leur travail
              et choisit les pièces qui la touchent. Elle veut maintenant
              partager ce plaisir avec ceux qui pousseront la porte.
            </p>
          </div>
        </div>
      </section>
    </div>
    <span
      class={styles.storyAnchor}
      data-story-anchor
      aria-hidden='true'></span>
  </div>
</section>
