MM_FONTS_SERVICE_URL=https://fonts.martinmoradi.com
MM_FONTS_FETCH_TOKEN=
MM_FONTS_ACCESS_CLIENT_ID=
MM_FONTS_ACCESS_CLIENT_SECRET=
MM_FONTS_CACHE_DIR=.cache/mm-fonts
MM_FONTS_OUTPUT_DIR=apps/marketing/public/fonts/generated

# Cloudflare Web Analytics site token for apps/marketing. Public by design (it
# appears in page source) but environment-specific; set it in the Cloudflare
# Pages build settings. With no token the beacon is omitted. See ADR-0006.
PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
